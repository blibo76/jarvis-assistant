{
  "jarvis": {
    "name": "J.A.R.V.I.S",
    "fullName": "Just A Rather Very Intelligent System",
    "version": "1.0.0",
    "description": "An AI assistant inspired by Iron Man's JARVIS with Arc Reactor UI and voice interaction",
    
    "voice": {
      "recognition": {
        "enabled": true,
        "language": "en-US",
        "continuous": false,
        "interimResults": true
      },
      "synthesis": {
        "enabled": true,
        "defaultVoice": "default",
        "voices": {
          "default": {
            "pitch": 1.0,
            "rate": 1.0,
            "volume": 1.0
          },
          "deep": {
            "pitch": 0.5,
            "rate": 0.9,
            "volume": 1.0
          },
          "robotic": {
            "pitch": 1.5,
            "rate": 1.2,
            "volume": 1.0
          }
        }
      }
    },
    
    "ui": {
      "theme": "dark",
      "colors": {
        "primary": "#00d4ff",
        "accent": "#ffeb3b",
        "background": "#0a0e27",
        "success": "#76ff03",
        "warning": "#ffff00",
        "error": "#ff0000"
      },
      "arcReactor": {
        "enabled": true,
        "animationSpeed": "medium",
        "glowIntensity": "high"
      }
    },
    
    "commands": {
      "wakeWord": "jarvis",
      "timeout": 30000,
      "maxRetries": 3
    },
    
    "features": {
      "backgroundListening": true,
      "commandHistory": true,
      "systemMonitoring": true,
      "autoRespond": true
    }
  }
}
